@model List<Menu.Models.Dish>

@{
    ViewData["Title"] = "MenuIndex";
}

<div class="container">
    <div class="row">
        @foreach(var item in Model)
        {
            <div class="col-6">
                <div>
                    @item.Name
                </div>
                <div>
                    @item.imageUrl
                </div>
                <div>
                    @item.price
                </div>
            </div>
        }
        
    </div>
</div>